# Copy to .env.local. Database scripts read DATABASE_URL from the environment
# or from .env.local. Do not commit .env.local.

# Hosted PostgreSQL connection string (Neon, Supabase, or similar).
DATABASE_URL=

# Firebase client configuration. NEXT_PUBLIC_ values are visible in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin credentials, verified only on the server.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
