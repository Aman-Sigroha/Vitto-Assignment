# Copy to .env.local. Database scripts read DATABASE_URL from the environment
# or from .env.local. Do not commit .env.local.

# Hosted PostgreSQL connection string (Neon, Supabase, or similar).
DATABASE_URL=

# Browser Firebase config. These values are public in the client bundle.
# Do not put the service account here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Loan id the dashboard opens. npm run db:seed prints this id.
# Use the overdue loan so the page shows a non-zero overdue amount.
# The value is public in the browser and differs between databases.
NEXT_PUBLIC_SEEDED_LOAN_ID=

# Server-only Firebase Admin credentials. Never prefix these with NEXT_PUBLIC_.
# Store the private key on one line with escaped newlines:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional. Used only by npm run test:integration. Not read by the app.
FIREBASE_TEST_EMAIL=
FIREBASE_TEST_PASSWORD=
